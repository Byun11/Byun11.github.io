---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { profile } from '../data/site';

// A link with no URL yet is dropped rather than rendered dead.
const all: { label: string; href: string; icon: IconName }[] = [
  { label: 'GitHub', href: profile.links.github, icon: 'github' },
  { label: 'LinkedIn', href: profile.links.linkedin, icon: 'linkedin' },
  { label: 'Scholar', href: profile.links.scholar, icon: 'graduation-cap' },
  { label: 'CV', href: profile.links.cv, icon: 'file-text' },
];
const links = all.filter((l) => l.href);

interface Props {
  layout?: 'row' | 'grid';
}
const { layout = 'row' } = Astro.props;
---

<ul class:list={['social', layout === 'grid' ? 'is-grid' : 'is-row']}>
  {
    links.map((l) => (
      <li>
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          class="glass group"
        >
          <Icon name={l.icon} size={18} class="relative shrink-0 text-[#6e6e73]" />
          <span class="relative">{l.label}</span>
          <Icon
            name="arrow-up-right"
            size={16}
            class="arrow relative ml-auto shrink-0 text-[#9a9a9f]"
          />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: grid;
    gap: 10px;
  }

  /* 2×2 on mobile — four labelled buttons never fit one row at 390px */
  .social.is-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .social.is-row {
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    justify-content: start;
  }

  .social a {
    display: flex;
    align-items: center;
    gap: 10px;
    height: var(--btn-h);
    padding: 0 18px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .social a:hover {
    transform: translateY(-2px);
    box-shadow:
      0 1px 2px rgba(21, 40, 74, 0.04),
      0 16px 38px rgba(21, 40, 74, 0.1);
  }

  .social.is-row a {
    gap: 8px;
  }

  /* the trailing arrow should not stretch a row-layout button */
  .social.is-row a :global(.arrow) {
    margin-left: 2px;
  }
</style>
