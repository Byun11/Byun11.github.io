---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { profile } from '../data/site';

// A link with no URL yet is dropped rather than rendered dead.
const all: { label: string; href: string | null; icon: IconName }[] = [
  { label: 'GitHub', href: profile.links.github, icon: 'github' },
  { label: 'LinkedIn', href: profile.links.linkedin, icon: 'linkedin' },
  { label: 'Scholar', href: profile.links.scholar, icon: 'graduation-cap' },
  // appears on its own once profile.links.cv is set
  { label: 'CV', href: profile.links.cv, icon: 'file-text' },
];
const links = all.filter((l) => Boolean(l.href));

---

<ul class="social">
  {
    links.map((l) => (
      <li>
        <a
          href={l.href!}
          target="_blank"
          rel="noopener noreferrer"
          class="glass group"
        >
          <Icon name={l.icon} size={18} class="relative shrink-0 text-[#111]" />
          <span class="relative label">{l.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    justify-content: center;
    flex-wrap: nowrap;
    gap: 5px;
  }

  .social a {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding: 0 9px;
    border-radius: var(--radius-pill);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-ink);
    white-space: nowrap;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .social a:hover {
    transform: translateY(-2px);
    box-shadow:
      0 1px 2px rgba(21, 40, 74, 0.04),
      0 16px 38px rgba(21, 40, 74, 0.1);
  }

  /* below ~380px four labelled pills stop fitting; drop to icons */
  @media (max-width: 379px) {
    .social .label {
      display: none;
    }
    .social a {
      padding: 0 14px;
    }
  }

  @media (min-width: 768px) {
    .social {
      justify-content: flex-start;
      gap: 10px;
    }
    .social a {
      height: var(--btn-h);
      padding: 0 20px;
      font-size: 15px;
      gap: 9px;
    }
  }
</style>
