---
// Replaces the DOCUMENT → AGENT → BROWSER text taxonomy. That diagram spelled
// the idea out in words; this shows it — a document floating behind a browser
// window whose fields are being filled, with the transferred value tinted so
// the eye connects the two without a label.
//
// If a rendered hero graphic (PNG/WebP) is produced later, pass `src` and this
// composition steps aside.

interface Props {
  src?: string;
  alt?: string;
  class?: string;
  compact?: boolean;
}
const { src, alt = '', class: cls = '', compact = false } = Astro.props;
---

<div class:list={['gv', compact && 'gv-compact', cls]}>
  {
    src ? (
      <img src={src} alt={alt} class="gv-img" loading="lazy" decoding="async" />
    ) : (
      <div class="gv-stage" role="img" aria-label="A document floating behind a browser window whose form fields are being filled from it">
        {/* document sheet, tilted and set back */}
        <div class="sheet">
          <span class="sheet-line w-3/5" />
          <span class="sheet-line w-full" />
          <span class="sheet-line w-11/12" />
          <span class="sheet-line is-source" />
          <span class="sheet-line w-4/5" />
          <span class="sheet-line w-2/3" />
        </div>

        {/* browser window in front */}
        <div class="browser">
          <div class="chrome">
            <span class="dot" />
            <span class="dot" />
            <span class="dot" />
            <span class="urlbar" />
          </div>
          <div class="form">
            <div class="field">
              <span class="label" />
              <span class="input is-filled" />
            </div>
            <div class="field">
              <span class="label" />
              <span class="input" />
            </div>
            <div class="field">
              <span class="label" />
              <span class="input is-active" />
            </div>
            <div class="field">
              <span class="label" />
              <span class="input" />
            </div>
          </div>
          <svg class="cursor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M5 3l14 8-6.2 1.6L9.6 19z"
              fill="#fff"
              stroke="#111"
              stroke-width="1.2"
              stroke-linejoin="round"
            />
          </svg>
        </div>
      </div>
    )
  }
</div>

<style>
  .gv {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .gv-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Only lit separately inside a card; on the bare hero the page backdrop
     already supplies the light and this would show as a hard-edged box. */
  :global(.card) .gv::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(58% 52% at 68% 22%, rgba(206, 222, 245, 0.9), transparent 72%),
      radial-gradient(50% 45% at 18% 88%, rgba(255, 253, 247, 0.95), transparent 70%);
  }

  .gv-stage {
    position: relative;
    width: min(80%, 400px);
    aspect-ratio: 4 / 3.2;
    margin-block: 6%;
  }

  .gv-compact .gv-stage {
    width: min(84%, 340px);
  }

  /* ── document ────────────────────────────────────────────────── */
  .sheet {
    position: absolute;
    top: -2%;
    left: 0;
    width: 52%;
    aspect-ratio: 3 / 4;
    display: flex;
    flex-direction: column;
    gap: 7%;
    padding: 11% 9%;
    border-radius: 14px;
    transform: rotate(-7deg);
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.6));
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow:
      0 2px 6px rgba(21, 40, 74, 0.05),
      0 22px 44px rgba(21, 40, 74, 0.1);
    /* set back in depth */
    filter: blur(0.4px);
  }

  .sheet-line {
    height: 4px;
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.14);
  }

  .sheet-line.is-source {
    width: 72%;
    background: linear-gradient(90deg, #8fb4e6, #c3d8f4);
    box-shadow: 0 0 0 4px rgba(143, 180, 230, 0.16);
  }

  /* ── browser ─────────────────────────────────────────────────── */
  .browser {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 74%;
    border-radius: 18px;
    overflow: visible;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.64));
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.92);
    box-shadow:
      0 1px 2px rgba(21, 40, 74, 0.04),
      0 26px 60px rgba(21, 40, 74, 0.14);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 9px 12px;
    border-bottom: 1px solid rgba(17, 17, 17, 0.06);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(17, 17, 17, 0.13);
  }

  .urlbar {
    margin-left: 8px;
    height: 9px;
    flex: 1;
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.06);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 14px 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .label {
    width: 34%;
    height: 4px;
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.16);
  }

  .input {
    height: 16px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(17, 17, 17, 0.08);
  }

  /* the value that came from the highlighted document line */
  .input.is-filled {
    background: linear-gradient(90deg, rgba(143, 180, 230, 0.32), rgba(255, 255, 255, 0.8) 62%);
    border-color: rgba(143, 180, 230, 0.55);
  }

  /* the field the agent is on right now */
  .input.is-active {
    border-color: rgba(17, 17, 17, 0.3);
    box-shadow: 0 0 0 3px rgba(17, 17, 17, 0.05);
  }

  .cursor {
    position: absolute;
    width: 20px;
    height: 20px;
    right: 17%;
    bottom: 23%;
    filter: drop-shadow(0 4px 8px rgba(21, 40, 74, 0.28));
  }

  /* §31 — a settle, nothing more. */
  .sheet,
  .browser {
    animation: settle 700ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  .browser {
    animation-delay: 120ms;
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(8px) rotate(var(--r, 0deg));
    }
  }

  .sheet {
    --r: -7deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet,
    .browser {
      animation: none;
    }
  }
</style>
