---
// Label + name + arrow. The two-line descriptions these cards used to carry
// were generic filler and made the row read like documentation.
interface Props {
  eyebrow: string;
  title: string;
  href: string;
  icon: 'book' | 'grid' | 'user';
}
const { eyebrow, title, href, icon } = Astro.props;
---

<a
  href={href}
  class="card group flex min-h-[124px] flex-col justify-between rounded-[24px] p-5 sm:min-h-[140px] sm:p-6"
>
  <span class="text-[#9a9a9f]" aria-hidden="true">
    {
      icon === 'book' && (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
        </svg>
      )
    }
    {
      icon === 'grid' && (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1.5" />
          <rect x="14" y="3" width="7" height="7" rx="1.5" />
          <rect x="3" y="14" width="7" height="7" rx="1.5" />
          <rect x="14" y="14" width="7" height="7" rx="1.5" />
        </svg>
      )
    }
    {
      icon === 'user' && (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 21a8 8 0 0 1 16 0" />
        </svg>
      )
    }
  </span>

  <span class="mt-5 flex items-end justify-between gap-2">
    <span>
      <span class="eyebrow block">{eyebrow}</span>
      <span class="display mt-1 block text-[21px] leading-tight sm:text-[23px]">
        {title}
      </span>
    </span>
    <span class="arrow pb-0.5 text-[13px] text-[#111]" aria-hidden="true">→</span>
  </span>
</a>
