---
import Icon from './Icon.astro';
import CircleArrow from './CircleArrow.astro';
import type { IconName } from '../lib/icons';

interface Props {
  title: string;
  body: string;
  href: string;
  icon: IconName;
}
const { title, body, href, icon } = Astro.props;
---

<a href={href} class="card navcard group">
  <Icon name={icon} size={20} class="text-[#111]" />
  <div class="foot">
    <h3 class="display name">{title}</h3>
    <p class="body">{body}</p>
    <CircleArrow size="sm" />
  </div>
</a>

<style>
  .navcard {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    min-height: 150px;
    padding: 18px;
    border-radius: var(--radius-card);
  }

  /* the arrow sits over the corner rather than in the text flow; inline it
     squeezed the description onto a third line */
  .foot {
    position: relative;
    padding-right: 44px;
  }

  .foot > :global(.circle) {
    position: absolute;
    right: 0;
    bottom: 0;
  }

  .name {
    font-size: 19px;
    line-height: 1.15;
  }

  .body {
    margin-top: 5px;
    font-size: 12.5px;
    line-height: 1.4;
    max-width: 22ch;
    color: var(--color-ink-2);
  }
</style>
