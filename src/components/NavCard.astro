---
interface Props {
  eyebrow: string;
  title: string;
  body: string;
  cta: string;
  href: string;
  icon: 'book' | 'grid' | 'user';
}
const { eyebrow, title, body, cta, href, icon } = Astro.props;
---

<a
  href={href}
  class="card group flex min-h-[180px] flex-col justify-between rounded-[24px] p-6 sm:min-h-[210px] sm:p-7"
>
  <div class="space-y-3">
    <span class="text-[#9a9a9f]" aria-hidden="true">
      {
        icon === 'book' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
          </svg>
        )
      }
      {
        icon === 'grid' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1.5" />
            <rect x="14" y="3" width="7" height="7" rx="1.5" />
            <rect x="3" y="14" width="7" height="7" rx="1.5" />
            <rect x="14" y="14" width="7" height="7" rx="1.5" />
          </svg>
        )
      }
      {
        icon === 'user' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21a8 8 0 0 1 16 0" />
          </svg>
        )
      }
    </span>
    <p class="eyebrow">{eyebrow}</p>
    <h3 class="display text-[22px] leading-tight">{title}</h3>
    <p class="text-[14px] leading-[1.55] text-[#6e6e73]">{body}</p>
  </div>

  <span class="mt-5 inline-flex items-center gap-1.5 text-[13px] font-medium text-[#111]">
    {cta} <span class="arrow" aria-hidden="true">→</span>
  </span>
</a>
