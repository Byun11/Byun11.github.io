---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

interface Props {
  eyebrow: string;
  title: string;
  href: string;
  icon: IconName;
}
const { eyebrow, title, href, icon } = Astro.props;
---

<a href={href} class="card navcard group">
  <Icon name={icon} size={20} class="text-[#9a9a9f]" />
  <span class="foot">
    <span>
      <span class="eyebrow block">{eyebrow}</span>
      <span class="display name">{title}</span>
    </span>
    <Icon name="arrow-right" size={16} class="arrow shrink-0 text-[#111]" />
  </span>
</a>

<style>
  .navcard {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--card-gap);
    min-height: 140px;
    padding: var(--card-pad);
    border-radius: var(--radius-card);
  }

  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .name {
    display: block;
    margin-top: 4px;
    font-size: 22px;
    line-height: 1.15;
  }
</style>
