---
// Spec §10 / §14 — an abstract "research identity" panel: layered translucent
// planes, thin lines, tiny labels. Deliberately NOT an architecture figure;
// the real one belongs on the project detail page.

interface Props {
  steps: readonly string[];
  caption?: string;
  class?: string;
}
const { steps, caption, class: cls = '' } = Astro.props;
---

<div class:list={['relative isolate overflow-hidden', cls]}>
  <!-- the one soft blue-gray gradient allowed by §10 -->
  <div
    class="absolute inset-0 -z-10"
    style="background: radial-gradient(70% 60% at 65% 18%, #eaf0f8, transparent 72%);"
    aria-hidden="true"
  >
  </div>

  <!-- extra bottom padding when a caption is absolutely positioned below -->
  <ol
    class:list={[
      'flex h-full flex-col justify-center gap-2 p-6 sm:gap-3 sm:p-10',
      caption && 'pb-12 sm:pb-14',
    ]}
  >
    {
      steps.map((step, i) => (
        <li class="pane" style={`--i:${i}`}>
          <div
            class="flex items-center gap-3 rounded-2xl border border-white/70 bg-white/55 px-4 py-3 backdrop-blur-[14px]"
            style={`margin-left: ${(i % 3) * 10}px; margin-right: ${((steps.length - i) % 3) * 8}px;`}
          >
            <span class="text-[10px] tabular-nums text-[#9a9a9f]">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="h-px flex-1 bg-[rgba(0,0,0,.07)]" aria-hidden="true" />
            <span class="text-[11px] font-medium tracking-[0.14em] text-[#111] uppercase">
              {step}
            </span>
          </div>
          {i < steps.length - 1 && (
            <div class="ml-6 h-3 w-px bg-[rgba(0,0,0,.10)]" aria-hidden="true" />
          )}
        </li>
      ))
    }
  </ol>

  {
    caption && (
      <p class="absolute bottom-4 left-6 text-[10px] tracking-[0.14em] text-[#9a9a9f] uppercase sm:left-10">
        {caption}
      </p>
    )
  }
</div>

<style>
  /* §31 — 4–8px translate and an opacity fade, nothing more. */
  .pane {
    animation: pane-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
    animation-delay: calc(var(--i) * 80ms + 200ms);
  }

  @keyframes pane-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pane {
      animation: none;
    }
  }
</style>
