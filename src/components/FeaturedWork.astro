---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import koniWide from '../assets/koni-visual-wide.png';
import koniTall from '../assets/koni-visual-tall.png';
import type { Project } from '../data/site';

interface Props {
  project: Project;
}
const { project } = Astro.props;

const demo = project.links?.demo;
const hasDetail = Boolean(project.detail?.length);
---

<article class="card feature">
  <div class="copy">
    <p class="eyebrow">Featured</p>

    <div>
      <h3 class="display title">{project.title}</h3>
      <p class="sub">{project.subtitle}</p>
    </div>

    <p class="blurb">{project.blurb}</p>

    <!-- at most two, as plain text rather than a row of pills -->
    <p class="tags">{project.tags.slice(0, 2).join(' · ')}</p>

    <div class="actions">
      {
        demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="glass demo">
            <span class="relative">Demo</span>
          </a>
        )
      }
      {
        hasDetail && (
          <a href={`/work/${project.slug}`} class="group view">
            View project
            <Icon name="arrow-up-right" size={16} class="arrow shrink-0" />
          </a>
        )
      }
    </div>
  </div>

  <div class="visual">
    <Image class="wide" src={koniWide} alt="" widths={[640, 960, 1400]} sizes="(min-width: 768px) 48vw, 100vw" loading="lazy" />
    <Image class="tall" src={koniTall} alt="" widths={[420, 780]} sizes="100vw" loading="lazy" />
  </div>
</article>

<style>
  .feature {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-feature);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--card-gap);
    padding: var(--card-pad);
  }

  .title {
    font-size: 24px;
    line-height: 1.1;
  }

  .sub {
    margin-top: 4px;
    font-size: 16px;
    color: var(--color-ink-2);
  }

  .blurb {
    max-width: 34ch;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .tags {
    font-size: 14px;
    color: var(--color-ink-3);
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 2px;
  }

  .demo {
    display: inline-flex;
    align-items: center;
    height: var(--btn-h);
    padding: 0 22px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    transition: transform 200ms ease;
  }

  .demo:hover {
    transform: translateY(-2px);
  }

  .view {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
  }

  .visual {
    position: relative;
    min-height: 260px;
  }

  .visual :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* the artwork has its own border plate; crop it out */
    transform: scale(1.14);
  }

  .visual :global(.wide) {
    display: none;
  }

  @media (min-width: 768px) {
    .feature {
      display: grid;
      grid-template-columns: 52% 48%;
      min-height: 380px;
    }

    .copy {
      justify-content: center;
      padding: 40px;
    }

    .title {
      font-size: 40px;
    }

    .sub {
      font-size: 17px;
    }

    .visual {
      min-height: 0;
      height: 100%;
      align-self: stretch;
    }

    .visual :global(.tall) {
      display: none;
    }

    .visual :global(.wide) {
      display: block;
    }
  }
</style>
