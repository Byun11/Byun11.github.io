---
import GlassVisual from './GlassVisual.astro';
import type { Project } from '../data/site';

interface Props {
  project: Project;
}
const { project } = Astro.props;

// Home shows the short line only; the full description lives on the detail
// page. The long version turned this card into a paper abstract.
const demo = project.links?.demo;
const hasDetail = Boolean(project.detail?.length);
---

<article
  class="card flex flex-col overflow-hidden rounded-[30px] md:grid md:min-h-[360px] md:grid-cols-[52%_48%]"
>
  <div class="order-1 flex flex-col justify-center gap-4 p-7 sm:p-9 md:order-1 md:p-10">
    <p class="eyebrow">Featured</p>

    <div class="space-y-1.5">
      <h3 class="display text-[32px] leading-[1.05] sm:text-[40px]">
        {project.title}
      </h3>
      <p class="text-[17px] text-[#6e6e73]">{project.subtitle}</p>
    </div>

    <p class="max-w-[34ch] text-[15px] leading-[1.55] text-[#6e6e73]">
      {project.blurb}
    </p>

    <!-- at most two, as one line of text rather than a row of pills -->
    <p class="text-[13px] text-[#9a9a9f]">{project.tags.slice(0, 2).join(' · ')}</p>

    <div class="mt-1 flex items-center justify-between gap-3">
      {
        demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="glass rounded-full px-5 py-2.5 text-[13px] font-medium transition-transform duration-200 hover:-translate-y-0.5"
          >
            <span class="relative">Demo</span>
          </a>
        )
      }
      {
        hasDetail && (
          <a
            href={`/work/${project.slug}`}
            class="group inline-flex items-center gap-1.5 text-[13px] font-medium text-[#111]"
          >
            View project <span class="arrow" aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>
  </div>

  <GlassVisual
    class="order-2 min-h-[260px] md:order-2 md:min-h-0"
  />
</article>
