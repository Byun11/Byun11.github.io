---
import { Image } from 'astro:assets';
import wide from '../assets/hero-ambient-wide.png';
import tall from '../assets/hero-ambient-tall.png';

// The background is a design element, not a fill. Glass only reads as glass
// when there is something behind it to refract. Two crops rather than one
// stretched image: the wide one loses its curve entirely at phone aspect.
---

<div class="backdrop" aria-hidden="true">
  <Image class="ambient wide" src={wide} alt="" widths={[1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" />
  <Image class="ambient tall" src={tall} alt="" widths={[640, 960, 1280]} sizes="100vw" loading="eager" fetchpriority="high" />
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: #f2f4f8;
  }

  .ambient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .wide {
    display: none;
  }

  /* The art is brightest at the top; fade it out before the page ends so the
     lower sections do not sit on a hard horizontal edge. */
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 38%, rgba(242, 244, 248, 0.82) 88%);
  }

  /* The hero text sits straight on the brightest part of the art at phone
     width; without this the eyebrow drops below AA contrast. */
  @media (max-width: 767px) {
    .backdrop::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 620px;
      background: linear-gradient(
        180deg,
        rgba(250, 251, 253, 0.55) 0%,
        rgba(250, 251, 253, 0.72) 42%,
        rgba(246, 248, 251, 0.35) 100%
      );
      z-index: 1;
    }
  }

  @media (min-width: 768px) {
    .tall {
      display: none;
    }
    .wide {
      display: block;
    }
  }
</style>
