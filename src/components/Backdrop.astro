---
// The background is a design element, not a fill. Glass only reads as glass
// when there is something behind it to refract — a flat #F5F5F7 leaves
// backdrop-filter with nothing to blur, so the cards come out as plain white.
// Everything here is deliberately near-invisible on its own.
---

<div class="backdrop" aria-hidden="true">
  <!-- ambient light: cool from the top right, warm from the lower left -->
  <div class="glow glow-cool"></div>
  <div class="glow glow-warm"></div>

  <!-- the large refracted surfaces the cards sit on top of -->
  <svg class="shapes" viewBox="0 0 1440 1200" preserveAspectRatio="xMidYMin slice">
    <defs>
      <linearGradient id="sheen" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
        <stop offset="45%" stop-color="#dce7f5" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0.15" />
      </linearGradient>
      <linearGradient id="sheen2" x1="1" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#eaf0f8" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0.1" />
      </linearGradient>
      <filter id="soften" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="26" />
      </filter>
      <filter id="soften-hard" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="9" />
      </filter>
    </defs>

    <!-- giant curved sheet sweeping across the upper half -->
    <path
      d="M -160 470 C 240 250 560 640 900 360 C 1140 165 1330 250 1620 120 L 1620 -120 L -160 -120 Z"
      fill="url(#sheen)"
      filter="url(#soften)"
      opacity="0.75"
    />
    <!-- its highlight edge: the thing that actually reads as a glass rim -->
    <path
      d="M -160 470 C 240 250 560 640 900 360 C 1140 165 1330 250 1620 120"
      fill="none"
      stroke="#ffffff"
      stroke-width="2.5"
      filter="url(#soften-hard)"
      opacity="0.9"
    />
    <path
      d="M -160 560 C 260 340 600 720 960 430 C 1200 240 1380 330 1620 210"
      fill="none"
      stroke="#ffffff"
      stroke-width="1.5"
      filter="url(#soften-hard)"
      opacity="0.5"
    />

    <!-- a second, quieter sheet lower down so scrolling never hits flat colour -->
    <path
      d="M -200 1080 C 200 900 520 1180 880 980 C 1140 840 1340 930 1640 830 L 1640 1320 L -200 1320 Z"
      fill="url(#sheen2)"
      filter="url(#soften)"
      opacity="0.5"
    />
  </svg>
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: linear-gradient(180deg, #eef1f6 0%, #f4f5f8 38%, #f2f4f8 100%);
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
  }

  .glow-cool {
    top: -22%;
    right: -14%;
    width: 68vw;
    height: 68vw;
    max-width: 1000px;
    max-height: 1000px;
    background: radial-gradient(
      circle,
      rgba(198, 217, 243, 0.85) 0%,
      rgba(223, 234, 248, 0.45) 45%,
      transparent 70%
    );
  }

  .glow-warm {
    bottom: -30%;
    left: -18%;
    width: 60vw;
    height: 60vw;
    max-width: 880px;
    max-height: 880px;
    background: radial-gradient(
      circle,
      rgba(255, 252, 246, 0.95) 0%,
      rgba(255, 250, 240, 0.5) 45%,
      transparent 72%
    );
  }

  .shapes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* the sheet belongs to the top of the page; it must not tile on scroll */
    min-height: 1200px;
  }

  @media (max-width: 767px) {
    .glow-cool {
      width: 110vw;
      height: 110vw;
      top: -18%;
      right: -30%;
    }
    .shapes {
      min-height: 900px;
    }
  }
</style>
