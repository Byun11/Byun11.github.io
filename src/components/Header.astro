---
import { nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="fixed inset-x-0 top-4 z-50 md:top-8">
  <div class="mx-auto w-[calc(100%-32px)] max-w-[1280px] md:w-[calc(100%-64px)]">
    <!-- Mobile: full-width glass panel (§21) -->
    <div
      class="glass-bar flex h-16 items-center justify-between rounded-[22px] px-5 md:hidden"
    >
      <a href="/" class="display text-xl tracking-tight">JB</a>
      <button
        type="button"
        id="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="glass flex h-10 w-10 items-center justify-center rounded-full"
      >
        <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true">
          <path d="M0 1h16M0 6h16M0 11h16" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>

    <!-- Desktop: small floating glass bar (§8) -->
    <div
      class="glass-bar hidden h-11 items-center justify-between rounded-full pl-6 pr-2 md:flex"
    >
      <a href="/" class="display text-lg tracking-tight">JB</a>
      <nav aria-label="Main">
        <ul class="flex items-center gap-1">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={[
                    'rounded-full px-4 py-1.5 text-[13px] transition-colors',
                    isCurrent(item.href)
                      ? 'bg-white/70 text-[#111]'
                      : 'text-[#6e6e73] hover:text-[#111]',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      id="mobile-menu"
      hidden
      class="glass mt-2 rounded-[22px] p-2 md:hidden"
    >
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="block rounded-2xl px-4 py-3 text-[15px] text-[#111]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
  });
</script>
