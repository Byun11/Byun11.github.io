---
import { nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header id="site-header" class="fixed inset-x-0 top-4 z-50 md:top-8">
  <div class="hwrap mx-auto max-w-[1280px]">
    <!-- Mobile: full-width glass panel (§21) -->
    <div class="mbar glass-bar md:hidden">
      <a href="/" class="display mbar-logo text-xl tracking-tight">JB</a>
      <button
        type="button"
        id="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="glass mbar-btn flex h-10 w-10 items-center justify-center rounded-full"
      >
        <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true">
          <path d="M0 1h16M0 6h16M0 11h16" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>

    <!-- Desktop: small floating glass bar (§8) -->
    <div
      class="glass-bar hidden h-11 items-center justify-between rounded-full pl-6 pr-2 md:flex"
    >
      <a href="/" class="display text-lg tracking-tight">JB</a>
      <nav aria-label="Main">
        <ul class="flex items-center gap-1">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={[
                    'rounded-full px-4 py-1.5 text-[13px] transition-colors',
                    isCurrent(item.href)
                      ? 'bg-white/70 text-[#111]'
                      : 'text-[#6e6e73] hover:text-[#111]',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      id="mobile-menu"
      hidden
      class="glass mt-2 rounded-[22px] p-2 md:hidden"
    >
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="block rounded-2xl px-4 py-3 text-[15px] text-[#111]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<script>
  // Condense the mobile bar once the page has scrolled, and never while the
  // menu is open. 40/16px hysteresis stops it flickering at the threshold.
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (!header) return;
    if (document.getElementById('mobile-menu')?.hidden === false) return;
    const y = window.scrollY;
    if (y > 40) header.classList.add('is-condensed');
    else if (y < 16) header.classList.remove('is-condensed');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
    // an open menu needs its logo and full bar back
    if (!open) header?.classList.remove('is-condensed');
    else onScroll();
  });
</script>

<style>
  .hwrap {
    width: calc(100% - var(--gutter) * 2);
  }

  @media (min-width: 768px) {
    .hwrap {
      width: calc(100% - 64px);
    }
  }

  /* Mobile: the full-width bar covers the page while scrolling, so past the
     first scroll it collapses to just the menu button on the right. */
  .mbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding-inline: 20px;
    border-radius: var(--radius-bar);
    margin-left: 0;
    transition:
      margin-left 320ms cubic-bezier(0.22, 0.61, 0.36, 1),
      height 320ms cubic-bezier(0.22, 0.61, 0.36, 1),
      padding 320ms cubic-bezier(0.22, 0.61, 0.36, 1),
      border-radius 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .mbar-logo {
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  :global(#site-header.is-condensed) .mbar {
    /* shrink from the left so the button stays put */
    margin-left: calc(100% - 46px);
    width: 46px;
    height: 46px;
    padding-inline: 0;
    justify-content: center;
    border-radius: 999px;
  }

  /* Condensed, the bar floats over body text. At the shared 55% white the
     text read straight through the button, so it gets a denser mix and a
     heavier blur: the colour behind still shows, the words do not. */
  :global(#site-header.is-condensed) .mbar {
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    box-shadow:
      0 1px 2px rgba(21, 40, 74, 0.04),
      0 10px 26px rgba(21, 40, 74, 0.1);
  }

  /* the bar itself is the control once condensed; a glass pill inside a
     glass pill was what made it read as a floating blob */
  :global(#site-header.is-condensed) .mbar-btn {
    background: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 0;
    box-shadow: none;
    width: 46px;
    height: 46px;
  }

  :global(#site-header.is-condensed) .mbar-logo {
    opacity: 0;
    transform: translateX(-8px);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .mbar,
    .mbar-logo {
      transition: none;
    }
  }
</style>
