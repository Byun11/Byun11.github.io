---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { about, profile } from '../data/site';
---

<Base title="About" description="Research interests, experience, and background.">
  <section
    class="mx-auto max-w-[1280px] px-5 pb-[72px] pt-[132px] md:px-8 md:pb-[120px] md:pt-[190px]"
  >
    <h1 class="display text-[40px] leading-tight md:text-[64px]">About</h1>

    <div class="mt-12 grid gap-12 md:mt-16 md:grid-cols-[minmax(0,620px)_1fr] md:gap-20">
      <div class="space-y-5">
        {
          about.bio.map((p) => (
            <p class="text-[16px] leading-[1.7] text-[#111] md:text-[17px]">{p}</p>
          ))
        }
      </div>

      <div class="space-y-10">
        <section>
          <h2 class="eyebrow">Research Interests</h2>
          <ul class="mt-4 space-y-1.5">
            {
              about.interests.map((i) => (
                <li class="text-[15px] text-[#111]">{i}</li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2 class="eyebrow">Experience</h2>
          <ul class="mt-4 space-y-4">
            {
              about.experience.map((e) => (
                <li>
                  <p class="text-[15px] text-[#111]">{e.org}</p>
                  <p class="text-[14px] text-[#6e6e73]">{e.role}</p>
                  <p class="text-[13px] text-[#9a9a9f]">{e.note}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2 class="eyebrow">Links</h2>
          <div class="mt-4"><SocialLinks /></div>
          {
            profile.links.email && (
              <a
                href={`mailto:${profile.links.email}`}
                class="mt-3 inline-block text-[14px] text-[#6e6e73] underline underline-offset-4"
              >
                {profile.links.email}
              </a>
            )
          }
        </section>
      </div>
    </div>
  </section>
</Base>
