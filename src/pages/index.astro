---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import GlassVisual from '../components/GlassVisual.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import NavCard from '../components/NavCard.astro';
import { profile, projects } from '../data/site';

const featured = projects.find((p) => p.featured)!;
---

<Base>
  <!-- ── HERO ───────────────────────────────────────────────────────
       Desktop hero is held to ~560px. It used to run near a full
       viewport, which read as unfinished rather than minimal. -->
  <section
    class="mx-auto max-w-[1280px] px-5 pb-[56px] pt-[124px] md:px-8 md:pb-[64px] md:pt-[148px]"
  >
    <div
      class="md:grid md:min-h-[400px] md:grid-cols-[54%_46%] md:items-center md:gap-8"
    >
      <div class="rise text-center md:text-left">
        <p class="eyebrow">{profile.title}</p>

        <!-- one line; it only breaks on genuinely narrow screens -->
        <h1
          class="display mt-4 text-[44px] leading-[1.02] whitespace-nowrap sm:text-[52px] md:mt-5 md:text-[72px] lg:text-[84px]"
        >
          {profile.name}
        </h1>

        <p class="mt-3 text-[14px] text-[#6e6e73] md:mt-4 md:text-[15px]">
          {profile.fields.join(' · ')}
        </p>

        <p
          class="mx-auto mt-4 max-w-[440px] text-[16px] leading-[1.5] text-[#6e6e73] md:mx-0 md:mt-5 md:text-[18px]"
        >
          {profile.summary}
        </p>

        <div class="mt-6 md:mt-8">
          <div class="md:hidden"><SocialLinks layout="grid" /></div>
          <div class="hidden md:block"><SocialLinks /></div>
        </div>
      </div>

      {/* wrapper carries the hiding: GlassVisual's scoped `display: grid`
          outranks Tailwind's `hidden` when applied to the same element */}
      <div class="hidden md:block">
        <GlassVisual class="min-h-[360px]" />
      </div>
    </div>
  </section>

  <!-- ── SELECTED WORK ────────────────────────────────────────────── -->
  <section class="mx-auto max-w-[1280px] px-5 md:px-8">
    <h2 class="display mb-5 text-[26px] md:mb-7 md:text-[30px]">Selected Work</h2>
    <FeaturedWork project={featured} />
  </section>

  <!-- ── SECONDARY NAVIGATION ─────────────────────────────────────── -->
  <section class="mx-auto mt-3 max-w-[1280px] px-5 md:mt-4 md:px-8">
    <div class="navcards grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
      <NavCard eyebrow="Publications" title="Papers" href="/publications" icon="book" />
      <NavCard eyebrow="Projects" title="Research" href="/work" icon="grid" />
      <NavCard eyebrow="About" title="Experience" href="/about" icon="user" />
    </div>
  </section>
</Base>

<style>
  /* mobile: two small cards, then About full-width underneath */
  @media (max-width: 767px) {
    .navcards > :global(:last-child) {
      grid-column: span 2;
    }
  }
</style>
