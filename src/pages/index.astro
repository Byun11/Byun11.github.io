---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import NavCard from '../components/NavCard.astro';
import { profile, projects } from '../data/site';

const featured = projects.find((p) => p.featured)!;
---

<Base>
  <div class="page">
    <section class="hero rise">
      <p class="eyebrow">{profile.title}</p>
      <h1 class="display name">{profile.name}</h1>
      <p class="fields">{profile.fields.join(' · ')}</p>
      <p class="summary">{profile.summary}</p>

      <div class="links">
        <div class="only-mobile"><SocialLinks layout="grid" /></div>
        <div class="only-desktop"><SocialLinks /></div>
      </div>

    </section>

    <section>
      <h2 class="display section-title">Selected Work</h2>
      <FeaturedWork project={featured} />
    </section>

    <section class="navcards">
      <NavCard eyebrow="Publications" title="Papers" href="/publications" icon="book-open" />
      <NavCard eyebrow="Projects" title="Research" href="/work" icon="layout-grid" />
      <NavCard eyebrow="About" title="Experience" href="/about" icon="user" />
    </section>
  </div>
</Base>

<style>
  .page {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-bottom: var(--section-gap);
  }

  .page > section + section {
    margin-top: var(--section-gap);
  }

  .navcards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 12px !important;
  }

  /* two small cards, then About full width underneath */
  .navcards > :global(:last-child) {
    grid-column: span 2;
    min-height: 0;
  }

  .hero {
    padding-top: calc(64px + var(--hero-top-gap));
    text-align: center;
  }

  .name {
    margin-top: 12px;
    font-size: 56px;
    line-height: 1.02;
  }

  .fields {
    margin-top: 10px;
    font-size: 16px;
    color: var(--color-ink-2);
  }

  .summary {
    max-width: 34ch;
    margin: 14px auto 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .links {
    margin-top: 28px;
  }

  .section-title {
    margin-bottom: 16px;
    font-size: 24px;
  }

  .only-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .page {
      padding-inline: 32px;
      padding-bottom: 96px;
    }

    .page > section + section {
      margin-top: 72px;
    }

    .only-mobile {
      display: none;
    }

    .only-desktop {
      display: block;
    }

    /* The ambient artwork now occupies the right side of the viewport, so the
       hero is one column of text rather than text + a drawn panel. */
    .hero {
      min-height: 400px;
      padding-top: 148px;
      text-align: left;
    }

    .name {
      font-size: 76px;
      white-space: nowrap;
    }

    .summary {
      margin-inline: 0;
      max-width: 30ch;
      font-size: 18px;
    }

    .section-title {
      font-size: 28px;
      margin-bottom: 20px;
    }

    .navcards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin-top: 16px !important;
    }

    .navcards > :global(:last-child) {
      grid-column: auto;
    }
  }
</style>
