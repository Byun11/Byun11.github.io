---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import NavCard from '../components/NavCard.astro';
import { profile, projects } from '../data/site';

const featured = projects.find((p) => p.featured)!;
---

<Base>
  <div class="page">
    <section class="hero rise">
      <!-- Name first, then the role beneath it: the role is a caption to the
           name, not a label above it. -->
      <h1 class="display name">{profile.name}</h1>
      <p class="role">{profile.title}</p>
      <p class="fields">{profile.fields.join(' · ')}</p>

      <div class="links"><SocialLinks /></div>
    </section>

    <!-- No section heading: the card announces itself with FEATURED. -->
    <section><FeaturedWork project={featured} /></section>

    <section class="navcards">
      <NavCard
        title="Publications"
        body="Selected papers and preprints"
        href="/publications"
        icon="book-open"
      />
      <NavCard
        title="Projects"
        body="Research projects and explorations"
        href="/work"
        icon="layout-grid"
      />
      <NavCard
        title="About"
        body="Research interests and experience"
        href="/about"
        icon="user"
      />
    </section>
  </div>
</Base>

<style>
  .page {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-bottom: 8px;
  }

  .page > section + section {
    margin-top: 12px;
  }

  .hero {
    padding-top: 104px;
    padding-bottom: 28px;
    text-align: center;
  }

  .name {
    font-size: clamp(30px, 9.6vw, 44px);
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .role {
    margin-top: 10px;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }

  .fields {
    margin-top: 16px;
    font-size: 14px;
    color: var(--color-ink-2);
  }

  .links {
    margin-top: 22px;
  }

  .navcards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  /* two side by side, About full width underneath */
  .navcards > :global(:last-child) {
    grid-column: span 2;
    min-height: 0;
  }

  @media (min-width: 768px) {
    .page {
      padding-inline: 32px;
      padding-bottom: 24px;
    }

    .page > section + section {
      margin-top: 16px;
    }

    .hero {
      padding-top: 168px;
      padding-bottom: 56px;
    }

    .name {
      font-size: clamp(48px, 6.4vw, 86px);
    }

    .role {
      margin-top: 16px;
      font-size: 15px;
    }

    .fields {
      margin-top: 20px;
      font-size: 16px;
    }

    .links {
      margin-top: 30px;
    }

    .navcards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .navcards > :global(:last-child) {
      grid-column: auto;
    }
  }
</style>
