---
import Base from '../../layouts/Base.astro';
import StackPanel from '../../components/StackPanel.astro';
import { projects } from '../../data/site';

export function getStaticPaths() {
  // Only projects with written detail content get a page (§28).
  return projects
    .filter((p) => p.detail?.length)
    .map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;

const actions = [
  { label: 'Paper', href: project.links?.paper },
  { label: 'Code', href: project.links?.code },
  { label: 'Demo', href: project.links?.demo },
].filter((a) => a.href);
---

<Base title={project.title} description={project.subtitle}>
  <article
    class="mx-auto max-w-[1280px] px-5 pb-[72px] pt-[132px] md:px-8 md:pb-[120px] md:pt-[190px]"
  >
    <a
      href="/work"
      class="group inline-flex items-center gap-1.5 text-[13px] text-[#6e6e73] transition-colors hover:text-[#111]"
    >
      <span aria-hidden="true">←</span> Work
    </a>

    <header class="mt-8 max-w-[800px]">
      <h1 class="display text-[40px] leading-[1.02] md:text-[72px]">
        {project.title}
      </h1>
      <p class="mt-3 text-[18px] text-[#6e6e73] md:text-[22px]">
        {project.subtitle}
      </p>

      <ul class="mt-6 flex flex-wrap gap-1.5">
        {
          project.tags.map((t) => (
            <li class="rounded-full border border-[rgba(0,0,0,.07)] px-3 py-1 text-[12px] text-[#6e6e73]">
              {t}
            </li>
          ))
        }
      </ul>
    </header>

    <StackPanel
      steps={['Document', 'Selective Retrieval', 'Browser Agent', 'Web Form']}
      caption="System sketch"
      class="card mt-12 min-h-[300px] rounded-[30px] md:mt-16 md:min-h-[380px]"
    />

    <div class="mt-14 grid gap-10 md:mt-20 md:grid-cols-[minmax(0,640px)_1fr] md:gap-16">
      <div class="space-y-10">
        {
          project.detail!.map((s) => (
            <section>
              <h2 class="eyebrow">{s.heading}</h2>
              <p class="mt-3 text-[16px] leading-[1.65] text-[#111]">{s.body}</p>
            </section>
          ))
        }
      </div>

      {
        actions.length > 0 && (
          <aside class="md:pt-1">
            <h2 class="eyebrow">Links</h2>
            <ul class="mt-4 space-y-2">
              {actions.map((a) => (
                <li>
                  <a
                    href={a.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="glass group inline-flex items-center gap-2 rounded-full px-4 py-2 text-[13px] font-medium transition-transform duration-200 hover:-translate-y-0.5"
                  >
                    <span class="relative">{a.label}</span>
                    <span class="arrow relative text-[#9a9a9f]" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </article>
</Base>
