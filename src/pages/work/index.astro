---
import Base from '../../layouts/Base.astro';
import WorkRow from '../../components/WorkRow.astro';
import { projects } from '../../data/site';

const selected = projects.filter((p) => !p.exploration);
const explorations = projects.filter((p) => p.exploration);
---

<Base title="Work" description="Research projects, prototypes, and open-source systems.">
  <section
    class="mx-auto max-w-[1280px] px-5 pb-[72px] pt-[132px] md:px-8 md:pb-[120px] md:pt-[190px]"
  >
    <h1 class="display text-[40px] leading-tight md:text-[64px]">Selected Work</h1>

    <ul class="mt-10 border-t border-[rgba(0,0,0,.07)] md:mt-14">
      {selected.map((p) => <WorkRow project={p} />)}
    </ul>

    {
      explorations.length > 0 && (
        <div class="mt-16 md:mt-24">
          <h2 class="eyebrow">Research Explorations</h2>
          <p class="mt-3 max-w-[60ch] text-[14px] leading-[1.6] text-[#6e6e73]">
            Open-ended work in progress. Listed for the record — these are
            experiments and controls, not finished systems.
          </p>
          <ul class="mt-6 border-t border-[rgba(0,0,0,.07)]">
            {explorations.map((p) => (
              <WorkRow project={p} compact />
            ))}
          </ul>
        </div>
      )
    }
  </section>
</Base>
